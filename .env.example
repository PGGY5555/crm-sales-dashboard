# =============================================================================
# CRM Sales Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Database ---
DATABASE_URL=mysql://user:password@host:3306/crm_production

# --- Session / JWT ---
# Used to sign session cookies. Generate a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Required on Cloud Run — must match Google Console Authorized redirect URI exactly
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback

# --- Owner account ---
# Google `sub` ID of the owner (auto-assigned admin role on login)
OWNER_OPEN_ID=

# --- Frontend (build-time, optional) ---
# Google sub of owner — used in User Management UI to protect owner row
VITE_OWNER_OPEN_ID=

# --- Server ---
NODE_ENV=development
PORT=8080

# --- Optional: File storage (Manus Forge proxy) ---
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=

# --- Optional: Analytics ---
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# --- Optional: External CRM API ---
# CRM_API_KEY=
